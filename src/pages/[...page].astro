---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import { MainPackageName, SiteTitle } from "../consts";
import { getPackageReleases, RELEASES_PER_PAGE } from "../libs/release";

import Timeline from "../components/Timeline.astro";
import Layout from "../layouts/Layout.astro";

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getPackageReleases(MainPackageName), {
    pageSize: RELEASES_PER_PAGE,
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
---

<Layout title={SiteTitle}>
  <Timeline packageName={MainPackageName} {page} title="Changelog" />
</Layout>
